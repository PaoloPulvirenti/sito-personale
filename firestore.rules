rules_version = '2';

// Nessun accesso diretto dai client: i messaggi li scrive solo l'API su Cloud Run,
// che usa il service account (le regole non si applicano agli SDK server).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
