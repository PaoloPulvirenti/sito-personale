# Variabili dell'API (api/src/config.ts). Nessun segreto: su Cloud Run le credenziali
# di Firestore arrivano dal service account del servizio.

# firestore | memory (memory = sviluppo senza emulatore, i messaggi si perdono al riavvio)
MESSAGE_STORE=memory
PORT=8080
LOG_LEVEL=info
LOG_PRETTY=true

# Solo con l'emulatore (docker compose up firestore):
# FIRESTORE_EMULATOR_HOST=localhost:8081
# GOOGLE_CLOUD_PROJECT=demo-sito-personale

FIRESTORE_COLLECTION=contactMessages
# Salti di proxy fidati per leggere l'IP del client da X-Forwarded-For (0 in locale).
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
PRIVACY_VERSION=2026-10-01
RETENTION_DAYS=365

# Avviso email a ogni messaggio (facoltativo). Senza SMTP_PASSWORD resta spento.
# NOTIFY_EMAIL_TO=paolo@example.com
# SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
