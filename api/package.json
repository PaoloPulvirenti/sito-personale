{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API del sito: form contatti su Firestore, servita da Cloud Run",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@google-cloud/firestore": "^9.3.0",
    "fastify": "^5.12.5",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
