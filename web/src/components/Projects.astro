---
import { Image } from 'astro:assets';
import { getContent } from '../content';
import { findImage } from '../lib/assets';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import Section from './Section.astro';
import Todo from './Todo.astro';

const { projects } = getContent();
---

<Section id="progetti" title={projects.title}>
  <div class="space-y-8">
    {projects.items.map((project) => {
      const screenshots = project.screenshots.flatMap((shot) => {
        const image = findImage(`progetti/${shot.file}`);
        return image ? [{ image, alt: shot.alt }] : [];
      });
      return (
        <article class="rounded-lg border border-border p-5 sm:p-7">
          <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-xl font-semibold">{project.title}</h3>
            <p class="font-mono text-xs text-muted">{project.kind}</p>
          </header>

          <dl class="mt-5 grid gap-4 sm:grid-cols-[7rem_1fr]">
            <dt class="text-sm font-semibold text-accent">{projects.problemLabel}</dt>
            <dd>{project.problem}</dd>
            <dt class="text-sm font-semibold text-accent">{projects.solutionLabel}</dt>
            <dd>{project.solution}</dd>
            <dt class="text-sm font-semibold text-accent">{projects.stackLabel}</dt>
            <dd>
              <ul class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <li class="tag">{tech}</li>
                ))}
              </ul>
            </dd>
          </dl>

          {screenshots.length > 0 && (
            <figure class="mt-6">
              <div class="grid gap-3 sm:grid-cols-2">
                {screenshots.map(({ image, alt }, index) => (
                  <a
                    href={image.src}
                    class:list={['block', index === 0 && 'sm:col-span-2']}
                    target="_blank"
                    rel="noopener"
                  >
                    <Image
                      src={image}
                      alt={alt}
                      widths={index === 0 ? [640, 1280] : [400, 800]}
                      sizes={
                        index === 0
                          ? '(min-width: 896px) 820px, 100vw'
                          : '(min-width: 896px) 405px, (min-width: 640px) 50vw, 100vw'
                      }
                      class="w-full rounded-md border border-border"
                    />
                  </a>
                ))}
              </div>
              {project.screenshotsNote && (
                <figcaption class="mt-2 text-xs text-muted">{project.screenshotsNote}</figcaption>
              )}
            </figure>
          )}
          {screenshots.length === 0 && project.screenshotsTodo && (
            <Todo class="mt-6">{project.screenshotsTodo}</Todo>
          )}

          {project.showArchitecture && <ArchitectureDiagram />}

          {project.links.length > 0 && (
            <p class="mt-5 flex flex-wrap gap-4">
              {project.links.map((link) => (
                <a class="link" href={link.href} rel="noopener">
                  {link.label} ↗
                </a>
              ))}
            </p>
          )}
        </article>
      );
    })}
  </div>
</Section>
