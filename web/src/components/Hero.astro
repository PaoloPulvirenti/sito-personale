---
import { Image } from 'astro:assets';
import { getContent } from '../content';
import { findImage } from '../lib/assets';
import Todo from './Todo.astro';

const { hero } = getContent();
const photo = findImage(hero.photo.file);
const initials = hero.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<section class="container-page pt-16 pb-16 sm:pt-24 sm:pb-20" aria-labelledby="hero-title">
  <div class="flex flex-col-reverse gap-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <p class="mb-3 font-mono text-sm text-accent">{hero.role}</p>
      <h1 id="hero-title" class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">
        {hero.name}
      </h1>
      <p class="mt-5 text-lg text-pretty text-muted">{hero.tagline}</p>
      <p class="mt-3 text-sm text-muted">{hero.location}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={hero.cv.href} download>
          <svg aria-hidden="true" viewBox="0 0 20 20" class="size-4" fill="currentColor">
            <path d="M10 2a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.42L9 11.6V3a1 1 0 0 1 1-1ZM4 16a1 1 0 1 0 0 2h12a1 1 0 1 0 0-2H4Z"></path>
          </svg>
          {hero.cv.label}
        </a>
        <a class="btn btn-secondary" href="#contatti">
          {hero.contactCta}
        </a>
      </div>
    </div>

    <div class="shrink-0">
      {photo ? (
        <Image
          src={photo}
          alt={hero.photo.alt}
          width={176}
          height={176}
          densities={[1, 2]}
          loading="eager"
          fetchpriority="high"
          class="size-36 rounded-full object-cover ring-1 ring-border sm:size-44"
        />
      ) : (
        <div class="flex flex-col items-start gap-2 sm:items-center">
          <div
            class="flex size-36 items-center justify-center rounded-full bg-accent-soft text-4xl font-bold text-accent sm:size-44"
            aria-hidden="true"
          >
            {initials}
          </div>
          <Todo class="max-w-44">foto in web/src/assets/{hero.photo.file}</Todo>
        </div>
      )}
    </div>
  </div>
</section>
