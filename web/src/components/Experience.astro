---
import { getContent } from '../content';
import Section from './Section.astro';

const { experience } = getContent();
---

<Section id="esperienza" title={experience.title}>
  <ol class="relative space-y-12 border-l border-border pl-6 sm:pl-8">
    {experience.items.map((item) => (
      <li class="relative">
        <span
          class="absolute top-2 -left-[calc(1.5rem+5px)] size-2.5 rounded-full bg-accent ring-4 ring-bg sm:-left-[calc(2rem+5px)]"
          aria-hidden="true"
        />
        <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-lg font-semibold">
            {item.role} <span class="text-muted">·</span>{' '}
            <span class="text-accent">{item.company}</span>
          </h3>
          <p class="font-mono text-sm text-muted">
            {item.period} · {item.location}
          </p>
        </div>
        <p class="mt-1 text-muted italic">{item.summary}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-accent">
          {item.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Section>
