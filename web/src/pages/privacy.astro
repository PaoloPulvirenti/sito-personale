---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getContent } from '../content';
import Base from '../layouts/Base.astro';

const { privacy, meta } = getContent();
---

<Base title={`${privacy.title} · ${meta.siteName}`} description={privacy.title}>
  <Header />
  <main id="contenuto" class="container-page max-w-2xl py-16">
    <h1 class="text-3xl font-bold tracking-tight">{privacy.title}</h1>
    <p class="mt-2 text-sm text-muted">{privacy.updated}</p>
    {privacy.sections.map((section) => (
      <section class="mt-10">
        <h2 class="text-lg font-semibold">{section.heading}</h2>
        <div class="mt-3 space-y-3 text-pretty">
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    ))}
  </main>
  <Footer />
</Base>
